rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == 'EMAIL_ADMIN_ANDA';  // ganti dengan email admin Anda
    }

    // Konten belajar: semua orang bisa membaca, hanya admin yang bisa menulis
    match /categories/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /classes/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /materials/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /videos/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /quizzes/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /assignments/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /announcements/{id}{ allow read: if true; allow write: if isAdmin(); }

    // Voucher: siapapun boleh membaca (untuk validasi kode di halaman login),
    // hanya admin yang boleh membuat/menonaktifkan voucher
    match /vouchers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
